load("@rules_cc//cc:defs.bzl","cc_binary","cc_library")

#Go to the rules_cc dependency,
#open cc/defs.bzl,
#and import the cc_binary rule.

cc_library(
    name="student",
    srcs=["student.cpp"],
    hdrs=["student.h"],
)

cc_library(
    name="student_database",
    srcs=["student_database.cpp"],
    hdrs=["student_database.h"],
    deps=[":student"],
)


cc_binary(
    name="app",
    srcs=["main.cpp"],
    deps=[
        ":student",
        ":student_database",
        ],
)